# AI provider credentials (server-side only — never expose to the browser).
# Copy to .env.local and fill in ONE provider. Never commit real keys.
# The app auto-detects whichever key is set.

# Option 1: Google Gemini (default model: gemini-3.8-flash, with automatic failover)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# AI_MODEL=gemini-3.8-flash

# Option 2: Any OpenAI-compatible endpoint
# (OpenAI, OpenRouter, Azure proxy, Ollama, LM Studio, ...)
# AI_API_KEY=your_api_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here
